{
  "name": "benji-scraper",
  "version": "1.0.0",
  "description": "Scraping BBC website for tracklist info",
  "main": "index.js",
  "scripts": {
    "coverage": "jest --coverage --silent",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "tasks": "rm -f *.log; node app/index.js",
    "lint:check": "prettier --check app/**/*.js",
    "lint:fix": "prettier --write app/**/*.js",
    "login": "node app/cli.js login",
    "print-auth-url": "node app/cli.js auth-url",
    "setup-auth": "node app/cli.js authenticate $AUTH_CODE",
    "check-auth": "node app/cli.js check-auth"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^30.5.2",
    "prettier": "^3.10.1"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "functions": 80
      }
    }
  }
}
